# Copy to .env.local. Any OpenAI-compatible chat completions endpoint works.
# The endpoint, model, and extra body can also be passed as --base-url, --model, --extra-body.
LEAN_EXPLAIN_BASE_URL=https://api.venice.ai/api/v1
LEAN_EXPLAIN_MODEL=deepseek-v4-pro
# Leave empty for a local server that needs no key.
LEAN_EXPLAIN_API_KEY=
# JSON merged into every request. This one turns off the system prompt Venice adds by default.
LEAN_EXPLAIN_EXTRA_BODY={"venice_parameters":{"include_venice_system_prompt":false}}
