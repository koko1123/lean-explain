# Copy to .env.local. With only VENICE_API_KEY set, the tool uses Venice and deepseek-v4-pro.
VENICE_API_KEY=

# Optional: any other OpenAI-compatible endpoint. These can also be passed as
# --base-url, --model, and --extra-body. VENICE_API_KEY is never sent to another endpoint.
# LEAN_EXPLAIN_BASE_URL=http://127.0.0.1:8080/v1
# LEAN_EXPLAIN_MODEL=inkling-2-mini
# LEAN_EXPLAIN_API_KEY=
# LEAN_EXPLAIN_EXTRA_BODY={"chat_template_kwargs":{"reasoning_effort":"low"}}
